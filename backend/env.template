# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

PORT=4000
NODE_ENV=development

# MongoDB Connection
# If you don't have MongoDB installed locally, you can use MongoDB Atlas (cloud)
MONGODB_URI=mongodb://localhost:27017/phoolse-fayda
# Or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/phoolse-fayda

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Blockchain (Aptos) - Optional
APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com
APTOS_FAUCET_URL=https://faucet.testnet.aptoslabs.com
APTOS_PRIVATE_KEY=your-aptos-private-key-here

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
