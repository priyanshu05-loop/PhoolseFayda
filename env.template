# Clerk Authentication Environment Variables
# Copy this file to .env.local and fill in your actual values

# Your Clerk Publishable Key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Your Clerk Secret Key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Clerk JWT Template (if using custom JWT)
# CLERK_JWT_TEMPLATE_NAME=your_jwt_template_name

# Optional: Clerk Webhook Secret (for webhook verification)
# CLERK_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Clerk Sign-in URL (defaults to /auth)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth

# Optional: Clerk Sign-up URL (defaults to /auth)
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth

# Optional: Clerk After Sign-in URL (defaults to /)
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Optional: Clerk After Sign-up URL (defaults to /)
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
